<?xml version="1.0" encoding="utf-8"?>
<!-- The app's manifest (rule 9; tasks/todo.md, M5 group 5; docs/mobile-apps.md, "Architecture"):
     no network permission, ever (a library that asks for one is rejected, never stripped); two
     permissions for the capture protection, HIDE_OVERLAY_WINDOWS (Android 12) and
     DETECT_SCREEN_RECORDING (Android 15); CAMERA for the go-ahead scanner (commit 18), asked on the
     scan screen alone, with the camera feature not required, so a phone with none types the code.
     Nothing is backed up (allowBackup, fullBackupContent and the data extraction rules) and no
     cleartext traffic is allowed. The Application class is the app's own, KeepCryptApp, whose
     uncaught-exception handler is the crash path (group 14). One exported activity, the launcher, and
     one instance of it (launchMode singleTask, Stage U's commit U2a): a second start, from the launcher,
     am start or another app's intent with FLAG_ACTIVITY_MULTIPLE_TASK, reaches the running activity and
     its one ceremony model. Only FLAG_ACTIVITY_CLEAR_TASK replaces it: the running one is finished, its
     model's end wipes the slot (fail closed), and a new one starts at First launch (lead decision M5-74).
     As singleTask clears what lies above it in its task, a start while a document picker, the camera
     prompt or the airplane-mode settings is up closes that activity: a picker answers nothing picked, the
     prompt nothing granted, and the settings return to Go offline.
     The one removal is the androidx.startup provider, which would run library initializers at
     start; profileinstaller, the one that writes files, is excluded from every configuration
     (build.gradle.kts). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".KeepCryptApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.KeepCrypt">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup" tools:node="remove" />
    </application>
</manifest>

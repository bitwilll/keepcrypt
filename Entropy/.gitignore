# Build output at any depth (the workspace and the standalone canaries in scripts/testdata/).
# Release artifacts come from CI only, so a local test-sources build never reaches git (rule 10).
target/

# The Android app's build output (tasks/todo.md, M5 group 2): every module's build/ at any depth
# under mobile/android/ (scripts/android-rust.sh writes libkeepcrypt.so to app/build/rust/), and
# any jniLibs/ directory as a guard, since the libraries are packaged from app/build/rust/ and
# never from a source tree. The gate refuses a tracked file under mobile/**/build/ or
# mobile/**/.gradle/ (scripts/banned-api-check.sh, Build), so an ignore here hides nothing from CI.
mobile/android/**/build/
mobile/android/**/jniLibs/
# Gradle's per-project cache, and the Android SDK path of one machine.
.gradle/
local.properties
# Built packages: every APK and AAB comes from CI (rule 10, as target/ above).
*.apk
*.aab

# macOS Finder metadata; it leaks folder names (Git: small, focused commits).
.DS_Store

# Backups. Real ceremony backups are never committed (rule 8, rule 12, Git section), not even
# under vectors/: no committed vector uses the .age extension.
*.age

# Key and secret material: never commit secrets or keys (rule 12, Git section).
# *.key also covers minisign secret keys (default name minisign.key), *.sec signify keys,
# *.jks and *.keystore Android signing keys.
*.key
*.sec
*.pem
*.p12
*.pfx
*.jks
*.keystore
# App signing (rule 12): App Store Connect API keys (AuthKey_<id>.p8) and Android signing
# passwords.
*.p8
keystore.properties
# SSH and GPG keys (rule 12), such as an Ed25519 signing key made with ssh-keygen; this also
# ignores the .pub halves, so add a public key on purpose with git add -f.
id_ed25519*
id_rsa*
*.gpg
# Environment and credential files (rule 12): direnv's .envrc and .netrc hold tokens.
.env
.env.*
.envrc
.netrc

# Python bytecode from local verify.py runs; generated, never reviewed source.
__pycache__/
*.py[cod]

# trybuild's scratch output: the .stderr of a new or changed compile-fail fixture lands here.
# The pinned .stderr files next to the fixtures are regenerated only with TRYBUILD=overwrite and
# reviewed; wip/ itself is never committed.
/core/wip/

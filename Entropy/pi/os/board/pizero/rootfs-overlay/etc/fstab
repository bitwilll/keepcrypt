# <file system> <mount point> <type> <options> <dump> <pass>
# The kernel mounts the SquashFS root read-only (cmdline.txt) and devtmpfs on /dev; BusyBox init's
# mount -a mounts these. The FAT boot partition is never mounted, and the USB stick only by the
# firmware, at /mnt/usb.
proc	/proc	proc	ro,nosuid,nodev,noexec	0	0
sysfs	/sys	sysfs	ro,nosuid,nodev,noexec	0	0
tmpfs	/tmp	tmpfs	nosuid,nodev,noexec,mode=1777,size=1m	0	0
tmpfs	/run	tmpfs	nosuid,nodev,noexec,mode=0755,size=1m	0	0

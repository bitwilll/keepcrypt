# The kernel's allow-list (tasks/todo.md, M4 group 13; Q37 (b)). kconfig.sh starts from
# bcmrpi_defconfig, turns every =m and MODULES off (with modules off, Kconfig would build every m
# in), applies this fragment, then runs olddefconfig, and fails unless every line below holds in
# the result. Required options are built in (=y); forbidden ones are not set, neither y nor m.
# Every other =y line of the final config is reviewed once, in pi/os/expected/linux.config, and
# anything not needed then gets its own line here.

# Required.
# SPI, for the display.
CONFIG_SPI_BCM2835=y
CONFIG_SPI_SPIDEV=y
# GPIO, for the keys, the display's DC and reset, and the backlight.
CONFIG_PINCTRL_BCM2835=y
CONFIG_GPIO_CDEV=y
CONFIG_RASPBERRYPI_GPIOMEM=y
# The hardware random number generator.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_BCM2835=y
# One USB stick: the host controller and mass storage.
CONFIG_USB_DWCOTG=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
# The stick's MBR partition table.
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# FAT32 on the stick; vfat's default iocharset is iso8859-1.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# The SD card, the SquashFS root and the kernel filesystems the image mounts.
CONFIG_MMC_BCM2835=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Freed memory is zeroed (cmdline.txt also sets init_on_free=1).
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
# The ACT LED's normal pattern under Linux, which the first boot check reads.
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_ACTPWR=y

# Forbidden.
# No modules, no network, no USB gadget mode.
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_USB_GADGET is not set
# No /dev/mem (rppal's fallback from /dev/gpiomem fails closed), no swap and no core dumps.
# CONFIG_DEVMEM is not set
# CONFIG_SWAP is not set
# CONFIG_ZSWAP is not set
# CONFIG_ZRAM is not set
# CONFIG_COREDUMP is not set
# No debugging hooks and no second kernel.
# CONFIG_DEBUG_FS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KEXEC is not set
# No console on a screen, no config in the kernel, no sysfs GPIO.
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_IKCONFIG is not set
# CONFIG_GPIO_SYSFS is not set
# Less kernel attack surface for a process that needs none of these.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_USER_NS is not set
# CONFIG_IO_URING is not set
# CONFIG_BINFMT_MISC is not set
# No sound, cameras, graphics, input devices or I2C (I2C until M8).
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB_TFT is not set
# CONFIG_HID is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_I2C is not set
# No USB drivers but mass storage.
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_UAS is not set
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_ACM is not set
# No filesystem but FAT, SquashFS and the kernel's own.
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_FUSE_FS is not set
# No partition table but MBR (every *_PARTITION of block/partitions/Kconfig at the kernel pin).
# CONFIG_ACORN_PARTITION is not set
# CONFIG_AIX_PARTITION is not set
# CONFIG_OSF_PARTITION is not set
# CONFIG_AMIGA_PARTITION is not set
# CONFIG_ATARI_PARTITION is not set
# CONFIG_IBM_PARTITION is not set
# CONFIG_MAC_PARTITION is not set
# CONFIG_SOLARIS_X86_PARTITION is not set
# CONFIG_LDM_PARTITION is not set
# CONFIG_SGI_PARTITION is not set
# CONFIG_ULTRIX_PARTITION is not set
# CONFIG_SUN_PARTITION is not set
# CONFIG_KARMA_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_SYSV68_PARTITION is not set
# CONFIG_CMDLINE_PARTITION is not set
# No hwrng driver but BCM2835 (every HW_RANDOM_* driver of drivers/char/hw_random/Kconfig,
# drivers/char/tpm/Kconfig and drivers/crypto/Kconfig at the kernel pin).
# CONFIG_HW_RANDOM_TIMERIOMEM is not set
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_HW_RANDOM_ATMEL is not set
# CONFIG_HW_RANDOM_BA431 is not set
# CONFIG_HW_RANDOM_IPROC_RNG200 is not set
# CONFIG_HW_RANDOM_GEODE is not set
# CONFIG_HW_RANDOM_N2RNG is not set

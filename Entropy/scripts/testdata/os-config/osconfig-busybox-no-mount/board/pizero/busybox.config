# The BusyBox config of the --os-config fixtures (scripts/banned-api-check.sh --selftest): the
# lines the check reads, as pi/os/board/pizero/busybox.config sets them.
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
# CONFIG_MOUNT is not set
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_FSTAB=y
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_BASH_IS_ASH is not set
# CONFIG_BASH_IS_HUSH is not set
CONFIG_BASH_IS_NONE=y
# CONFIG_ASH is not set
# CONFIG_HUSH is not set
# CONFIG_GETTY is not set
# CONFIG_LOGIN is not set
# CONFIG_UDHCPC is not set
# CONFIG_SEEDRNG is not set
# CONFIG_VI is not set

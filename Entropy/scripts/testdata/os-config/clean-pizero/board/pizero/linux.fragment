# The kernel allow-list of the --os-config fixtures (scripts/banned-api-check.sh --selftest): a few
# of pi/os/board/pizero/linux.fragment's lines, of its two kinds.

# Required.
CONFIG_SPI_BCM2835=y
CONFIG_SPI_SPIDEV=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_BCM2835=y
CONFIG_SQUASHFS=y
CONFIG_TTY=y

# Forbidden.
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_DEVMEM is not set
# CONFIG_HW_RANDOM_TIMERIOMEM is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
